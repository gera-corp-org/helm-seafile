# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Не нужно внутри пакета
.github/
docs/
scripts/
tests/
Chart.lock
# ArtifactHub читает его из реестра как отдельный OCI-артефакт,
# а не из содержимого чарта
artifacthub-repo.yml
