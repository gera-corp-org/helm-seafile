# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Not needed inside the package
.github/
docs/
scripts/
# Without a leading slash, the "tests/" pattern would match any tests
# directory at any depth, including templates/tests/ — the helm test
# hook, which must ship in the package. The slash anchors the pattern
# to the chart root.
/tests/
Chart.lock
# ArtifactHub reads this from the registry as a separate OCI artifact,
# not from the chart contents
artifacthub-repo.yml
