{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "seafile chart values",
  "type": "object",
  "properties": {
    "clusterDomain": { "type": "string", "minLength": 1 },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "seafile": {
      "type": "object",
      "required": ["serverHostname", "protocol"],
      "properties": {
        "serverHostname": { "type": "string" },
        "protocol": { "enum": ["http", "https"] },
        "timeZone": { "type": "string" },
        "logToStdout": { "type": "boolean" },
        "admin": {
          "type": "object",
          "properties": {
            "email": { "type": "string" },
            "password": { "type": "string" }
          }
        },
        "jwtPrivateKey": { "type": "string" },
        "webdav": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        },
        "existingSecret": { "type": "string" },
        "extraEnv": { "type": "array" },
        "extraEnvFrom": { "type": "array" }
      }
    },
    "database": {
      "type": "object",
      "required": ["enabled", "port", "user"],
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "user": { "type": "string", "minLength": 1 },
        "password": { "type": "string" },
        "rootPassword": { "type": "string" },
        "existingSecret": { "type": "string" },
        "names": {
          "type": "object",
          "properties": {
            "ccnet": { "type": "string", "minLength": 1 },
            "seafile": { "type": "string", "minLength": 1 },
            "seahub": { "type": "string", "minLength": 1 }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "storageClass": { "type": "string" },
            "existingClaim": { "type": "string" }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "cache": {
      "type": "object",
      "required": ["provider", "enabled", "port"],
      "properties": {
        "provider": { "enum": ["redis", "memcached"] },
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "password": { "type": "string" },
        "existingSecret": { "type": "string" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "storageClass": { "type": "string" },
        "existingClaim": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "host": { "type": "string" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        },
        "webdav": {
          "type": "object",
          "properties": { "path": { "type": "string" } }
        },
        "traefik": {
          "type": "object",
          "properties": { "buffering": { "type": "boolean" } }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "resources": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "startupProbe": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" }
  }
}
